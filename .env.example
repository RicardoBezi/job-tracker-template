# Hosted API (Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional runtime override for a restricted application role.
GCN_DATABASE_URL=postgresql://gcn_app:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
AUTH_PASSWORD_HASH=scrypt$SALT$HASH
SESSION_SECRET=generate-at-least-32-random-bytes
SCANNER_TOKEN=generate-a-separate-32-byte-token
ROUTINE_URL=https://claude.ai/code/routines/trig_xxxxxxxxxxxxxxxxxxxx

# Used by scripts/tracker.mjs in the Claude cloud routine
TRACKER_API_URL=https://your-project.vercel.app
